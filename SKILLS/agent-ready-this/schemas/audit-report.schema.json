{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-ready-this/audit.schema.json",
  "title": "Agent Ready This repository audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "signals",
    "inventory"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generator": {
      "type": "string"
    },
    "repository": {
      "type": "object"
    },
    "signals": {
      "type": "object"
    },
    "inventory": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
